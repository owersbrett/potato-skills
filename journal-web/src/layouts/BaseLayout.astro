---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'Journal';
const { title, description = 'A working journal — structured notes to my future self.' } =
  Astro.props;
const pageTitle = title ? `${title} · ${SITE}` : `${SITE} — a working journal`;

const nav = [
  { href: '/', label: 'Entries' },
  { href: '/tags', label: 'Tags' },
  { href: '/search', label: 'Search' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Set theme before paint to avoid a flash of the wrong theme. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches;
          const theme = stored ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true"></span>
          <span class="brand__name">Journal</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'site-nav__link',
                  {
                    active:
                      item.href === '/'
                        ? path === '/'
                        : path.startsWith(item.href),
                  },
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>Written for my future self. Rendered by <strong>journal-web</strong>.</p>
        <p class="site-footer__meta">A static Astro renderer for the context-journal contract.</p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid var(--border);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 4rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--text);
        font-weight: 680;
        letter-spacing: -0.01em;
        font-size: var(--step-1);
      }
      .brand__mark {
        width: 1.05rem;
        height: 1.05rem;
        transform: rotate(45deg);
        border-radius: 3px;
        background: linear-gradient(135deg, var(--accent), var(--flavor-fry));
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: clamp(0.5rem, 2vw, 1.4rem);
      }
      .site-nav__link {
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 550;
        font-size: var(--step-0);
        padding: 0.3rem 0.1rem;
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .site-nav__link:hover {
        color: var(--text);
      }
      .site-nav__link.active {
        color: var(--text);
        border-bottom-color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--border);
        padding-block: 2.5rem;
        color: var(--text-muted);
        font-size: var(--step--1);
      }
      .site-footer__inner {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .site-footer__meta {
        color: var(--text-faint);
      }

      @media (max-width: 34rem) {
        .site-nav {
          gap: 0.75rem;
        }
        .brand__name {
          display: none;
        }
        .site-nav__link {
          font-size: var(--step--1);
        }
      }
    </style>
  </body>
</html>
