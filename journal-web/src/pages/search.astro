---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search the journal by title, through-line, diamonds, and tags.">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Find</p>
    <h1 class="title">Search</h1>
    <p class="lead">Fuzzy match over titles, through-lines, diamonds, and tags.</p>

    <div class="search-box">
      <svg class="search-box__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
        <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search entries…"
        autocomplete="off"
        aria-label="Search entries"
        autofocus
      />
    </div>

    <p id="search-status" class="status" aria-live="polite"></p>
    <ul id="search-results" class="results"></ul>
  </div>
</BaseLayout>

<script>
  interface Item {
    slug: string;
    title: string;
    through_line: string;
    diamonds: string[];
    tags: string[];
    flavor: string;
    date: string;
    reading_time: number;
  }

  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLParagraphElement;

  let items: Item[] = [];
  let ready = false;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!),
    );

  function score(item: Item, q: string): number {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return 0;
    const haystacks: [string, number][] = [
      [item.title.toLowerCase(), 6],
      [item.tags.join(' ').toLowerCase(), 4],
      [item.through_line.toLowerCase(), 3],
      [item.diamonds.join(' ').toLowerCase(), 2],
    ];
    let total = 0;
    for (const term of terms) {
      let best = 0;
      for (const [text, weight] of haystacks) {
        if (text.includes(term)) best = Math.max(best, weight);
      }
      if (best === 0) return 0; // every term must match somewhere
      total += best;
    }
    return total;
  }

  function render(q: string) {
    const query = q.trim();
    if (!query) {
      results.innerHTML = '';
      status.textContent = ready ? `${items.length} entries indexed.` : '';
      return;
    }
    const matches = items
      .map((item) => ({ item, s: score(item, query) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s);

    status.textContent = `${matches.length} ${matches.length === 1 ? 'result' : 'results'} for "${query}"`;

    results.innerHTML = matches
      .map(({ item }) => {
        const tags = item.tags
          .map((t) => `<span class="r-tag">#${esc(t)}</span>`)
          .join('');
        const diamond = item.diamonds[0] ? esc(item.diamonds[0]) : '';
        return `
          <li class="result">
            <a href="/posts/${item.slug}">
              <div class="r-meta">
                <span class="r-flavor" data-flavor="${item.flavor}"></span>
                <span>${esc(item.date)}</span>
                <span class="r-sep">·</span>
                <span>${item.reading_time} min</span>
              </div>
              <h2 class="r-title">${esc(item.title)}</h2>
              <p class="r-dek">${esc(item.through_line)}</p>
              ${diamond ? `<p class="r-diamond">◆ ${diamond}</p>` : ''}
              <div class="r-tags">${tags}</div>
            </a>
          </li>`;
      })
      .join('');
  }

  async function load() {
    try {
      const res = await fetch('/search-index.json');
      items = await res.json();
      ready = true;
      render(input.value);
    } catch {
      status.textContent = 'Could not load the search index.';
    }
  }

  input.addEventListener('input', () => render(input.value));
  load();
</script>

<style>
  .title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    letter-spacing: -0.025em;
    margin-block: 0.4rem 0.5rem;
  }
  .lead {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.2rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-box__icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--text-faint);
    flex: none;
  }
  #search-input {
    flex: 1;
    border: none;
    background: none;
    padding: 0.75rem 0;
    font: inherit;
    font-size: var(--step-1);
    color: var(--text);
    outline: none;
  }

  .status {
    margin-top: 1rem;
    color: var(--text-faint);
    font-size: var(--step--1);
    min-height: 1.2em;
  }

  .results {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .results :global(.result a) {
    display: block;
    text-decoration: none;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .results :global(.result a:hover) {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .results :global(.r-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .results :global(.r-sep) {
    color: var(--text-faint);
  }
  .results :global(.r-flavor) {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--flavor-potato);
  }
  .results :global(.r-flavor[data-flavor='tater']) { background: var(--flavor-tater); }
  .results :global(.r-flavor[data-flavor='pierogi']) { background: var(--flavor-pierogi); }
  .results :global(.r-flavor[data-flavor='fry']) { background: var(--flavor-fry); }
  .results :global(.r-title) {
    font-size: var(--step-1);
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .results :global(.result a:hover .r-title) {
    color: var(--accent);
  }
  .results :global(.r-dek) {
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .results :global(.r-diamond) {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin-top: 0.4rem;
    padding-left: 0.1rem;
  }
  .results :global(.r-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin-top: 0.5rem;
  }
  .results :global(.r-tag) {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
</style>
