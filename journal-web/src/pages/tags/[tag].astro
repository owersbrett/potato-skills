---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getEntries, getTags, type Entry } from '../../lib/entries';

export async function getStaticPaths() {
  const [entries, tags] = await Promise.all([getEntries(), getTags()]);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      entries: entries.filter((e: Entry) => e.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  entries: Entry[];
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Journal entries tagged ${tag}.`}>
  <div class="wrap">
    <a class="back" href="/tags">← All tags</a>
    <p class="eyebrow">Tag</p>
    <h1 class="title">#{tag}</h1>
    <p class="lead">
      {entries.length} {entries.length === 1 ? 'entry' : 'entries'}
    </p>

    <div class="grid">
      {entries.map((entry) => <EntryCard entry={entry} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 550;
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--accent);
  }
  .title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    letter-spacing: -0.025em;
    margin-block: 0.4rem 0.4rem;
  }
  .lead {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
</style>
