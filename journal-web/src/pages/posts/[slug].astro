---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlavorBadge from '../../components/FlavorBadge.astro';
import Diamonds from '../../components/Diamonds.astro';
import { getEntries, formatDate, readingTime, type Entry } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry: Entry, i: number) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      newer: entries[i - 1] ?? null,
      older: entries[i + 1] ?? null,
    },
  }));
}

interface Props {
  entry: Entry;
  newer: Entry | null;
  older: Entry | null;
}

const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const mins = readingTime(entry);
---

<BaseLayout title={data.title} description={data.through_line}>
  <article class="post wrap wrap--narrow">
    <a class="back" href="/">← All entries</a>

    <header class="post__header">
      <div class="post__meta">
        <FlavorBadge flavor={data.flavor} showNote />
        <time datetime={data.date}>{formatDate(data.date)}</time>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span>{mins} min read</span>
        <span class="dot-sep" aria-hidden="true">·</span>
        <span class="audience">for {data.audience}</span>
      </div>

      <h1 class="post__title">{data.title}</h1>
      <p class="post__through-line">{data.through_line}</p>

      {
        data.tags.length > 0 && (
          <ul class="post__tags">
            {data.tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {data.cover && <img class="post__cover" src={data.cover} alt="" />}

    <Diamonds diamonds={data.diamonds} />

    <div class="prose">
      <Content />
    </div>

    {
      data.source && (
        <footer class="provenance">
          <span class="provenance__label">Provenance</span>
          <p>
            {data.source.summary}
            {data.source.duration && (
              <span class="provenance__dur"> · {data.source.duration}</span>
            )}
            <span class="provenance__kind"> · {data.source.kind}</span>
          </p>
        </footer>
      )
    }

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More entries">
          {older ? (
            <a class="post-nav__item" href={`/posts/${older.data.slug}`}>
              <span class="post-nav__dir">← Older</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post-nav__item post-nav__item--right" href={`/posts/${newer.data.slug}`}>
              <span class="post-nav__dir">Newer →</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<script>
  // Add a copy button to every code block. Small, post-page-only island.
  for (const pre of document.querySelectorAll('.prose pre')) {
    const el = pre as HTMLElement;
    el.style.position = 'relative';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.addEventListener('click', async () => {
      const code = el.querySelector('code')?.textContent ?? el.innerText;
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('is-copied');
        }, 1600);
      } catch {
        btn.textContent = 'Failed';
      }
    });
    el.appendChild(btn);
  }
</script>

<style>
  .post {
    padding-block: 1rem 2rem;
  }
  .back {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 550;
    margin-bottom: 1.75rem;
  }
  .back:hover {
    color: var(--accent);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .dot-sep {
    color: var(--text-faint);
  }
  .audience {
    text-transform: lowercase;
  }

  .post__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .post__through-line {
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 60ch;
  }
  .post__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    padding: 0;
    margin-top: 1rem;
    font-size: var(--step--1);
  }
  .post__tags a {
    color: var(--text-faint);
    text-decoration: none;
  }
  .post__tags a:hover {
    color: var(--accent);
  }

  .post__cover {
    width: 100%;
    border-radius: var(--radius);
    margin-top: 1.75rem;
    border: 1px solid var(--border);
  }

  .provenance {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .provenance__label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    color: var(--text-faint);
    margin-bottom: 0.3rem;
  }
  .provenance__dur,
  .provenance__kind {
    color: var(--text-faint);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-nav__item:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .post-nav__item--right {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav__dir {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .post-nav__title {
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
  }
  @media (max-width: 34rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------------------------------------------------------------
     Prose — the reading experience. ~68ch measure, strong hierarchy.
     Rendered Markdown HTML is not scoped, so target it globally under .prose.
     --------------------------------------------------------------------- */
  .prose {
    margin-top: 2.5rem;
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.72;
    color: var(--text);
  }
  .prose :global(> * + *) {
    margin-top: 1.15em;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.4rem;
    margin-bottom: 0.2rem;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    font-size: var(--step-1);
    margin-top: 1.9rem;
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    max-width: var(--measure);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .prose :global(strong) {
    font-weight: 660;
    color: var(--text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4rem;
  }
  .prose :global(li) {
    margin-top: 0.4em;
  }
  .prose :global(li)::marker {
    color: var(--accent);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.2rem 0 0.2rem 1.1rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin-block: 2.2rem;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-inline: auto;
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    word-break: break-word;
  }
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.6;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  /* Shiki dual-theme: swap variables in dark mode */
  :global(:root[data-theme='dark']) .prose :global(.astro-code),
  :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  .prose :global(.copy-btn) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .prose :global(pre:hover .copy-btn),
  .prose :global(.copy-btn:focus-visible) {
    opacity: 1;
  }
  .prose :global(.copy-btn.is-copied) {
    color: var(--accent);
    border-color: var(--accent);
    opacity: 1;
  }
</style>
