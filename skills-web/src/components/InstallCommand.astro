---
/** Terminal-style install command with a copy button. */
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="install">
  <code class="install-command"><span class="prompt" aria-hidden="true">$</span>{command}</code>
  <button type="button" class="copy" data-command={command} aria-label="Copy install command">
    copy
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.command ?? '');
      button.textContent = 'copied!';
      setTimeout(() => (button.textContent = 'copy'), 1500);
    });
  });
</script>

<style>
  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--terminal-bg);
    border: 1px solid var(--terminal-border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 1rem;
    overflow-x: auto;
  }

  .install-command {
    color: var(--terminal-text);
    font-size: var(--step--1);
    white-space: nowrap;
    flex: 1;
  }

  .prompt {
    color: var(--terminal-accent);
    margin-inline-end: 0.6ch;
    user-select: none;
  }

  .copy {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: none;
    border: 1px solid var(--terminal-border);
    border-radius: 4px;
    color: var(--terminal-accent);
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .copy:hover {
    background: rgba(255, 178, 87, 0.12);
  }
</style>
