---
import { family, skillDir, skillUrl, topic, type Skill } from '../lib/skills';

/** One row in the directory list — rank, name, source path, description, topic. */
interface Props {
  skill: Skill;
  rank: number;
}

const { skill, rank } = Astro.props;
---

<li
  class="row"
  data-search={`${skill.data.name} ${skill.data.description} ${family(skill)} ${topic(skill)}`.toLowerCase()}
>
  <span class="rank" aria-hidden="true">#{rank}</span>
  <div class="row-body">
    <div class="row-head">
      <a class="name" href={skillUrl(skill)}>{skill.data.name}</a>
      <span class="dir">{skillDir(skill)}</span>
      <span class="topic">{topic(skill)}</span>
    </div>
    <p class="description">{skill.data.description}</p>
  </div>
</li>

<style>
  .row {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm);
  }

  .row:hover {
    border-color: var(--accent);
  }

  .rank {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: var(--step--1);
    padding-top: 0.2rem;
    min-width: 2.2rem;
  }

  .row-body {
    min-width: 0;
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .name {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-strong);
  }

  .dir {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .topic {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
  }

  .description {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
