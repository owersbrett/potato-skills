---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import {
  allSkills,
  family,
  installCommand,
  related,
  skillDir,
  skillUrl,
  sourceUrl,
  topic,
  FAMILIES,
} from '../../lib/skills';

export async function getStaticPaths() {
  const skills = await allSkills();
  return skills.map((skill) => ({
    params: { slug: skill.data.name },
    props: { skill, skills },
  }));
}

const { skill, skills } = Astro.props;
const { Content } = await render(skill);
const siblings = related(skill, skills);
const familyNote = FAMILIES[family(skill)]?.note;
---

<BaseLayout title={`${skill.data.name} — potato-skills`} description={skill.data.description}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">skills</a>
    <span aria-hidden="true">/</span>
    <span>{skill.data.name}</span>
  </nav>

  <div class="detail">
    <article>
      <header class="skill-header">
        <h1>{skill.data.name}</h1>
        <span class="topic">{topic(skill)}</span>
      </header>
      <p class="description">{skill.data.description}</p>

      <h2 class="section-label">Install</h2>
      <InstallCommand command={installCommand(skill)} />

      <h2 class="section-label">SKILL.md</h2>
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside aria-label="Skill metadata">
      <dl>
        <div>
          <dt>Source</dt>
          <dd><a href={sourceUrl(skill)} rel="noopener">{skillDir(skill)}</a></dd>
        </div>
        <div>
          <dt>Family</dt>
          <dd>{family(skill)}</dd>
        </div>
        {familyNote && (
          <div>
            <dt>About the family</dt>
            <dd>{familyNote}</dd>
          </div>
        )}
        <div>
          <dt>License</dt>
          <dd>Apache 2.0</dd>
        </div>
      </dl>
    </aside>
  </div>

  {siblings.length > 0 && (
    <section class="related" aria-label="Related skills">
      <h2 class="section-label">Related skills</h2>
      <ul>
        {siblings.map((s) => (
          <li>
            <a href={skillUrl(s)}>{s.data.name}</a>
            <p>{s.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .detail {
      grid-template-columns: 1fr;
    }
  }

  .skill-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .skill-header h1 {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .topic {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
  }

  .description {
    color: var(--text-muted);
    max-width: 60ch;
    margin-block: 0.75rem 0;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin: 2.25rem 0 0.75rem;
  }

  aside {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 4.5rem;
  }

  aside dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  aside dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  aside dd {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    word-break: break-word;
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
  }

  .related li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    padding: 0.9rem 1.1rem;
  }

  .related li:hover {
    border-color: var(--accent);
  }

  .related a {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .related p {
    margin: 0.35rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
