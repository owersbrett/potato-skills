---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallCommand from '../components/InstallCommand.astro';
import SkillRow from '../components/SkillRow.astro';
import { allSkills, INSTALL_BASE } from '../lib/skills';

const skills = await allSkills();

const AGENTS = [
  'Claude Code',
  'Cursor',
  'Codex',
  'Gemini CLI',
  'GitHub Copilot',
  'VS Code',
  'Zed',
];
---

<BaseLayout
  title="potato-skills — open-source agent skills"
  description="Open-source agent skills that generate essential, interconnected infrastructure for the departments of your business."
>
  <section class="hero">
    <pre class="wordmark-art" aria-hidden="true">
█▀█ █▀█ ▀█▀ ▄▀█ ▀█▀ █▀█   █▀ █▄▀ █ █░░ █░░ █▀
█▀▀ █▄█ ░█░ █▀█ ░█░ █▄█   ▄█ █░█ █ █▄▄ █▄▄ ▄█</pre>
    <h1 class="visually-hidden">potato-skills</h1>
    <p class="tagline">
      Open-source agent skills that generate essential infrastructure —
      pieces that connect to each other, for every department of your business.
    </p>
    <div class="hero-install">
      <InstallCommand command={`${INSTALL_BASE} --skill <name>`} />
    </div>
    <p class="agents">Works with {AGENTS.join(' · ')} — any agent that reads a SKILL.md.</p>
  </section>

  <section aria-label="Skill directory">
    <div class="list-head">
      <h2>All skills <span class="count">({skills.length})</span></h2>
      <input
        type="search"
        id="skill-search"
        placeholder="Search skills…"
        aria-label="Search skills"
      />
    </div>
    <ul class="skill-list" id="skill-list">
      {skills.map((skill, i) => <SkillRow skill={skill} rank={i + 1} />)}
    </ul>
    <p class="no-results" id="no-results" hidden>No skills match that search.</p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('skill-search') as HTMLInputElement;
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>('#skill-list [data-search]'),
  );
  const empty = document.getElementById('no-results')!;

  input.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const match = !query || (row.dataset.search ?? '').includes(query);
      row.hidden = !match;
      if (match) visible++;
    }
    empty.hidden = visible > 0;
  });
</script>

<style>
  .hero {
    text-align: center;
    padding-block: clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
  }

  .wordmark-art {
    display: inline-block;
    text-align: left;
    font-size: clamp(0.55rem, 2.4vw, 1.15rem);
    line-height: 1.35;
    color: var(--accent);
    text-shadow: 2px 2px 0 var(--highlight);
    margin: 0 0 1.25rem;
    overflow-x: auto;
    max-width: 100%;
  }

  .tagline {
    max-width: 46rem;
    margin: 0 auto 1.5rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: balance;
  }

  .hero-install {
    max-width: 34rem;
    margin-inline: auto;
  }

  .agents {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .list-head h2 {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    margin: 0;
  }

  .count {
    color: var(--text-faint);
    font-weight: 400;
  }

  #skill-search {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    min-width: min(20rem, 100%);
  }

  #skill-search:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .no-results {
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-align: center;
    padding-block: 2rem;
  }
</style>
